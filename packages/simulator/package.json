{
  "name": "@dw/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node --env-file-if-exists=../../.env.local dist/scripts/seed-demo.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@dw/contracts": "workspace:*",
    "@dw/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
