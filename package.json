{
  "name": "dw-solutions",
  "private": true,
  "description": "DW Solutions — MDM web para smartphones Android corporativos (modo simulador).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash infrastructure/local/setup.sh",
    "dev:api": "pnpm --filter @dw/api dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @dw/db generate",
    "db:migrate": "pnpm --filter @dw/db build && pnpm --filter @dw/db migrate",
    "db:seed": "pnpm --filter @dw/db build && pnpm --filter @dw/db seed",
    "platform": "pnpm -r --filter @dw/db --filter @dw/api build >/dev/null && node --env-file=.env.local apps/api/dist/scripts/platform.js",
    "e2e": "pnpm build && pnpm --filter @dw/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
