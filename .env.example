# Copie para .env.local (o script de setup gera automaticamente com senhas aleatórias).
# Nunca coloque valores reais neste arquivo.
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=info

# Papel da aplicação (sem BYPASSRLS) — ADR-0004
DATABASE_URL=postgres://dw_app:<senha>@127.0.0.1:5432/dw_dev
# Papel de migrações
MIGRATOR_DATABASE_URL=postgres://dw_migrator:<senha>@127.0.0.1:5432/dw_dev
# Banco de testes
TEST_DATABASE_URL=postgres://dw_app:<senha>@127.0.0.1:5432/dw_test
TEST_MIGRATOR_DATABASE_URL=postgres://dw_migrator:<senha>@127.0.0.1:5432/dw_test
PLATFORM_DATABASE_URL=postgres://dw_platform:<senha>@127.0.0.1:5432/dw_dev
TEST_PLATFORM_DATABASE_URL=postgres://dw_platform:<senha>@127.0.0.1:5432/dw_test

REDIS_URL=redis://127.0.0.1:6379

# Identidade (ADR-0003): papel exclusivo do Better Auth
AUTH_DATABASE_URL=postgres://dw_auth:<senha>@127.0.0.1:5432/dw_dev
TEST_AUTH_DATABASE_URL=postgres://dw_auth:<senha>@127.0.0.1:5432/dw_test
# Origem pública (o site Next.js encaminha /api para a API)
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# 32 bytes aleatórios em hexadecimal (o setup gera)
BETTER_AUTH_SECRET=<gerado>
